                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e-b2-b3" value="x&lt;sub&gt;1&lt;/sub&gt; → … → x&lt;sub&gt;n&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=9;labelBackgroundColor=#ffffff;fontColor=#333333;" parent="1" edge="1" source="b2" target="b3">
                    <mxGeometry relative="1" as="geometry" />
