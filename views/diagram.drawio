                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e-group-a4-nocall" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;labelBackgroundColor=#ffffff;fontColor=#333333;" parent="1" edge="1" source="group-nocall" target="a4-nocall">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e-a4-a5-nocall" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;labelBackgroundColor=#ffffff;fontColor=#333333;" parent="1" edge="1" source="a4-nocall" target="a5-nocall">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e-a5-b3-call" value="&lt;b&gt;A&lt;sub&gt;call&lt;/sub&gt;, π&lt;sub&gt;call&lt;/sub&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=3;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;labelBackgroundColor=#ffffff;fontColor=#9673a6;" parent="1" edge="1" source="a5-call" target="b3-call">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e-a5-b3-nocall" value="&lt;b&gt;A&lt;sub&gt;no call&lt;/sub&gt;, π&lt;sub&gt;no call&lt;/sub&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=3;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;labelBackgroundColor=#ffffff;fontColor=#9673a6;" parent="1" edge="1" source="a5-nocall" target="b3-nocall">
                    <mxGeometry relative="1" as="geometry" />
